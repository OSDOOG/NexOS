{
    "name": "esp8266",
    "display_name": "Espressif ESP8266",
    "architecture": "xtensa",
    "cpu": "lx106",
    "fpu": false,
    "clock_mhz": 80,
    "ram_bytes": 81920,
    "flash_bytes": 4194304,
    "profile": "standard",
    "toolchain": {
        "prefix": "xtensa-lx106-elf-",
        "compiler": "xtensa-lx106-elf-gcc",
        "cflags": "-mlongcalls -O2 -ffunction-sections -fdata-sections -Wall",
        "ldflags": "-T platforms/esp8266/linker/esp8266.ld -Wl,--gc-sections"
    },
    "output_format": "bin",
    "flash_tool": "esptool.py",
    "flash_args": "--chip esp8266 --baud 115200 write_flash 0x0 {output_file}",
    "capabilities": [
        "GPIO",
        "UART",
        "SPI",
        "I2C",
        "PWM",
        "ADC",
        "TIMER",
        "RTC",
        "WIFI",
        "FLASH",
        "DEEP_SLEEP"
    ],
    "default_pins": {
        "led": 2,
        "uart_tx": 1,
        "uart_rx": 3,
        "i2c_sda": 4,
        "i2c_scl": 5
    }
}
